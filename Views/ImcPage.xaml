<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ImcMvvm.ViewModels"
             x:Class="ImcMvvm.Views.ImcPage"
             x:DataType="vm:ImcViewModel"
             Title="Calculadora de IMC">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Label Text="Calcula tu IMC"
                   FontSize="26"
                   FontAttributes="Bold" />

            <Label Text="Peso en kilogramos" />
            <Entry Placeholder="Ejemplo: 70"
                   Keyboard="Numeric"
                   Text="{Binding PesoTexto, Mode=TwoWay}" />

            <Label Text="Estatura en metros" />
            <Entry Placeholder="Ejemplo: 1.75"
                   Keyboard="Numeric"
                   Text="{Binding EstaturaTexto, Mode=TwoWay}" />

            <Button Text="Calcular IMC"
                    Command="{Binding CalcularCommand}" />

            <Label Text="{Binding Resultado}"
                   FontSize="22" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>